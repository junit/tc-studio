[Unit]
Description=TIM API instance on port %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/opt/tim /var/lib/tim

[Service]
Type=simple
User=tim
Group=tim
WorkingDirectory=/opt/tim
EnvironmentFile=/etc/tim/tim.env
ExecStart=/opt/tim/.venv/bin/python -m uvicorn app:app --host 127.0.0.1 --port %i --log-level info
Restart=on-failure
RestartSec=3s
KillMode=control-group
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tim
LimitNOFILE=65536
LimitNPROC=512
MemoryMax=2G
TasksMax=512
CPUQuota=200%

[Install]
WantedBy=multi-user.target
